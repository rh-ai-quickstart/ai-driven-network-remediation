# AI Driven Network Remediation — deployment configuration
# Create .env without replacing an existing file: test -e .env || cp .env.example .env
# Edit this file after copying it, then load in Bash: set -a && source .env && set +a
# Log in to the hub cluster and run make deploy. Make uses the exported values.
# Reload after edits or opening a new shell; Make does not load .env itself.
# This file uses Bash assignment syntax; quote values containing spaces or special characters.
# Active values below match deployment defaults, except required endpoint examples.
# Commented assignments are optional overrides; leave them commented to use defaults.
# For product deployment, follow README.md and disable both development mocks.
# Make defaults enable mocks; copying this file alone does not configure real services.
# Development setup, mock usage, and bypasses are documented in CONTRIBUTING.md.

# ── Required model configuration ──────────────────────────────────
# make deploy requires all three ADNR_LLM_* values (no defaults).
# Use the model ID served by your endpoint; its OpenAI-compatible URL ends in /v1.
# Make registers adnr-llm/<ID> in Llama Stack and sets all services' model IDs.
ADNR_LLM_ID=granite-3-2-8b-instruct
ADNR_LLM_URL=https://your-llm-endpoint.example.com/v1
ADNR_LLM_TOKEN=replace-with-your-llm-api-token

# Required when ENABLE_TELCO_ORAN=true (default). URL must include /v1/detect.
# Use a URL reachable by hub pods; integration tests also need access from your shell.
# External route lookup (if using the supplied predictor):
#   oc get route ran-ml-service-external -n model-serving -o jsonpath='https://{.spec.host}/v1/detect'
ADNR_DETECT_INFERENCE_URL=https://your-ran-ml-predictor.example.com/v1/detect
# Empty by default: the detector sends a Bearer token only when one is provided.
ADNR_DETECT_TOKEN=

# ── Hub deployment ────────────────────────────────────────────────
# Dedicated namespaces used by install/cleanup and edge access rules.
NAMESPACE=hub
EDGE_NAMESPACE=dark-noc-edge
# 1 = single cluster; N >= 2 = one hub PLUS N spokes. Deployment mode is derived.
CLUSTER_COUNT=1
# Select hub components; both share the model and document-ingestion services.
ENABLE_NETWORK_REMEDIATION=true
ENABLE_TELCO_ORAN=true
# Require OpenShift authentication for both dashboard Routes when true.
# The false default allows unauthenticated access for development.
FRONTEND_AUTH_ENABLED=false
# Ingestion pipeline: ingest bundled documents when the service starts.
AUTO_INGEST_ON_STARTUP=true
# Application image registry/tag used by Helm and image build/push targets.
REGISTRY=quay.io/rh-ai-quickstart
VERSION=0.1.5

# ── Real automation and ticketing integrations ────────────────────
# Set ENABLE_AAP_MOCK=false and supply AAP_TOKEN OR AAP_SECRET_NAME (key: AAP_TOKEN).
# Disabling the mock selects real AAP; it does not disable AAP execution.
# An existing secret in NAMESPACE takes precedence over AAP_TOKEN for both use cases.
# AAP_NAMESPACE controls prerequisite checks and Lightspeed token discovery.
# Network and RAN default to http://aap.aap.svc; changing AAP_NAMESPACE does not change it.
# AAP_NAMESPACE=aap
# AAP_TOKEN=replace-with-your-aap-token
# AAP_SECRET_NAME=noc-aap-secret

# Internal Gitea is enabled automatically with real AAP, disabled with the mock.
# It is always disabled when ENABLE_NETWORK_REMEDIATION=false (Telco-only).
# Its bootstrap seeds generated-playbooks for AAP. Defaults: noc, random password,
# noc@local. These overrides configure both Gitea and the Network bootstrap.
# GITEA_ADMIN_USER=noc
# GITEA_ADMIN_PASSWORD=replace-with-your-gitea-password
# GITEA_ADMIN_EMAIL=noc@local
# External Gitea is not fully wired through the AAP bootstrap; see docs/integration-setup.md.

# Lightspeed playbook generation requires an installed AAP/Lightspeed service.
# When enabled, Make discovers the URL and token from the cluster if unset.
# Product setup: docs/integration-setup.md#lightspeed; set ENABLE_LIGHTSPEED=true.
ENABLE_LIGHTSPEED=false
# LIGHTSPEED_URL=https://your-lightspeed-api.example.com
# LIGHTSPEED_TOKEN=replace-with-your-lightspeed-token
# The false default skips certificate verification for development endpoints.
# Set true for real Lightspeed integrations with trusted certificates.
LIGHTSPEED_VERIFY_SSL=false

# Set ENABLE_SERVICENOW_MOCK=false to wire a real ServiceNow instance.
# SERVICENOW_INSTANCE_URL feeds the bootstrap scripts, the dashboard incident
# links, and the MCP server when ENABLE_SERVICENOW_MOCK=false.
# SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
# Preferred: SERVICENOW_INSTANCE_URL + SERVICENOW_API_KEY. The API key is
# generated by 'make servicenow-bootstrap'.
# SERVICENOW_API_KEY=replace-with-your-servicenow-rest-api-key
# Basic auth fallback: SERVICENOW_INSTANCE_URL + SERVICENOW_USERNAME + SERVICENOW_PASSWORD.
# SERVICENOW_USERNAME / SERVICENOW_PASSWORD are the admin creds used by
# 'make servicenow-bootstrap' and the Basic-auth fallback the Makefile forwards
# to the deploy.
# SERVICENOW_USERNAME=your-servicenow-admin
# SERVICENOW_PASSWORD=replace-with-your-servicenow-admin-password
# With ENABLE_SERVICENOW_MOCK=false, 'make helm-install' wires these automatically
# (no HELM_EXTRA_ARGS needed).
# The chart does not pass ServiceNow credentials to the dashboard backend;
# authenticated dashboard incident counts require a separate runtime change.
# Create resolved tickets after successful Network auto-remediation, in addition
# to escalation tickets. Kafka auditing remains enabled regardless of this flag.
SERVICENOW_CREATE_RESOLVED=false
# Bootstrap account creation requires administrator access; see
# scripts/servicenow-bootstrap/README.md before running those commands.

# Slack notifications from the Network agent only; requires a bot token/channel.
ENABLE_SLACK=false
SLACK_BOT_TOKEN=replace-with-your-slack-bot-token
SLACK_CHANNEL='#ai-driven-network'

# ── Development only: mocks and execution bypass ──────────────────
# Use mocks when developing other components without real AAP/ServiceNow access.
# Both defaults are true. Mock success does not mean a workload was repaired or
# a real ticket was created. Setup and verification: CONTRIBUTING.md.
# ENABLE_AAP_MOCK=true
# ENABLE_SERVICENOW_MOCK=true
# Generation-only development: skip AAP execution after Lightspeed generates a
# playbook. Existing-template Network jobs and RAN automation are unaffected.
# Default false. This is an agent-service runtime variable: Make/Helm do NOT
# forward it from .env. Apply it to the agent process or development Deployment
# as described in CONTRIBUTING.md; uncommenting here alone does not set pod env.
# LIGHTSPEED_SKIP_AAP=true

# ── Optional observability ─────────────────────────────────────────
# Network LokiStack deployment + MCP log queries; requires the Loki operator.
ENABLE_LOKISTACK=false
# Kafka browser UI (requires the default bundled Kafka deployment).
ENABLE_KAFKA_UI=false
# Separate Langfuse release; credentials are generated/preserved in a Secret.
# Unset by default (disabled). Application tracing is not wired up yet.
# ENABLE_LANGFUSE=true

# ── Edge delivery / multiple clusters ──────────────────────────────
# Used by make deploy / edge-deploy / ACM helpers; helm-install installs the hub.
# See docs/multi-cluster-deploy.md for operators, imported spokes and cleanup.
# Spokes must be named <SPOKE_NAME_PREFIX>-01 .. -NN.
SPOKE_NAME_PREFIX=edge-site
# Hub ManagedCluster name used by ACM placement.
ACM_HUB_CLUSTER=local-cluster
# false = use imported spokes; true = provision through Hive (CLUSTER_COUNT >= 2).
CLUSTER_CREATE=false
# Edge chart Git source. Needed for GitOps validation even with helm-install,
# except single-cluster EDGE_GITOPS=helm.
GITOPS_REPO_URL=https://github.com/rh-ai-quickstart/ai-driven-network-remediation.git
GITOPS_REVISION=main
# Single cluster: auto = Argo CD if available, otherwise Helm; argocd/helm force it.
# Multiple clusters always use Argo CD.
EDGE_GITOPS=auto
# Argo CD automatically corrects drift in edge Applications.
EDGE_SELF_HEAL=true
# Default: false for single cluster, true for multiple clusters. Enabling requires
# the Logging operator, Kafka client certificates and the hub Kafka Route.
# CLUSTER_LOG_FORWARDER_ENABLED=false
# Route hostname only (no scheme/port). Hub-spoke make deploy auto-detects it;
# set it for single-cluster or standalone helpers when log forwarding is enabled.
# KAFKA_EXTERNAL_HOST=kafka.apps.hub.example.com
# Argo CD namespace is detected when unset.
# ARGOCD_NAMESPACE=openshift-gitops
# Hive provisioning only: base domain is required; image set/region have defaults.
# Configure Hive pull-secret/cloud credentials per the multi-cluster guide first.
# HIVE_BASE_DOMAIN=lab.example.com
# HIVE_CLUSTER_IMAGE_SET=img4.20.12-x86-64-appsub
# HIVE_AWS_REGION=us-east-1

# AAP execution via the ACM cluster proxy, separate from CLUSTER_COUNT topology.
# Requires real AAP, ManagedServiceAccount addon, and both values below.
ENABLE_MULTICLUSTER=false
# CLUSTER_PROXY_URL=https://your-cluster-proxy.example.com
# RHACM_HUB_TOKEN=replace-with-your-hub-service-account-token
