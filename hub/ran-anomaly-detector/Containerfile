# Build context for this image must be `hub/` (not this directory), since the
# project depends on the sibling `telco-oran` package via a local uv path source.
# See: `make build-ran-anomaly-image` in the root Makefile.
FROM python:3.13-slim AS builder
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0

WORKDIR /app

# Sibling packages are copied one level up so the "../<pkg>" path sources in
# ran-anomaly-detector/pyproject.toml resolve correctly from /app.
COPY shared/ /shared/
COPY telco-oran/ /telco-oran/

COPY ran-anomaly-detector/pyproject.toml ran-anomaly-detector/uv.lock ./

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project --no-editable --no-dev

COPY ran-anomaly-detector/ /app/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-editable --no-dev

FROM python:3.13-slim

COPY --from=builder /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8002
CMD ["ran-anomaly-detector-server"]
