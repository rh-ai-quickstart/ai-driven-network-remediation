# NOTE: $binary_remote_addr is not a reliable per-browser key here -- nginx's
# only visible peer is the OpenShift Route's router (or, with the oauth-proxy
# gate on, the sidecar at 127.0.0.1), not the original client. So these zones
# are a coarse blast-radius bound (per router replica, or fully shared once
# the gate is on), not true per-client throttling. See "Access control" in
# FRONTEND.md for why a real fix (trusted X-Forwarded-For) isn't safe to add
# generically here.
#
# Generous: GET /api/summary and GET /api/integrations each poll every 10s, and
# POST /api/chat is click-driven but not dangerous — 100r/m with a 30-request
# burst comfortably covers normal dashboard usage with headroom to spare.
limit_req_zone $binary_remote_addr zone=noc_api_read:10m  rate=100r/m;

# Strict: POST /api/demo/trigger publishes straight to the real Kafka pipeline
# and is click-driven, not polled — a handful per minute is generous for the
# 4 demo scenario buttons while bounding a scripted flood.
limit_req_zone $binary_remote_addr zone=noc_api_write:10m rate=6r/m;

server {
    # NGINX_LISTEN_ADDRESS defaults to 0.0.0.0 (see Containerfile) so the Service
    # can reach this container directly when global.frontendAuth.enabled is
    # false. When that gate is on, Helm overrides it to 127.0.0.1 so this
    # container is reachable only from the oauth-proxy sidecar sharing this
    # pod's network namespace (its `--upstream=http://localhost:8080`) --
    # otherwise any in-cluster client could hit this pod's IP on 8080 directly
    # and skip OAuth entirely, bypassing the Service/targetPort switch.
    # Substituted by the base image's docker-entrypoint.d/20-envsubst-on-templates.sh
    # at container startup; nginx's own $-prefixed variables below (e.g. $host)
    # are untouched since they aren't real environment variables.
    listen ${NGINX_LISTEN_ADDRESS}:8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location ~ ^/api/demo/(trigger|reset)$ {
        limit_req zone=noc_api_write burst=3 nodelay;
        proxy_pass http://hub-chatbot-service:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
        proxy_connect_timeout 10s;
    }

    location /api/ {
        limit_req zone=noc_api_read burst=30 nodelay;
        proxy_pass http://hub-chatbot-service:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
