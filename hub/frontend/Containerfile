ARG BUILDPLATFORM

# Build static assets on the native build platform to avoid esbuild crashes
# under amd64 emulation on Apple Silicon. The generated dist/ files are
# architecture-agnostic and can be copied into the target runtime image.
FROM --platform=$BUILDPLATFORM node:22-bookworm-slim AS builder
ARG VITE_ENABLE_TELCO_ORAN=true
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
RUN npm run build

FROM docker.io/nginxinc/nginx-unprivileged:1.27-alpine
COPY --from=builder /app/dist /usr/share/nginx/html
# Templated (not a static conf.d file) so the listen address can be overridden
# at deploy time without an image rebuild -- see nginx.conf.template and
# hub/helm/templates/frontend.yaml (global.frontendAuth.enabled). Rendered by
# the base image's own docker-entrypoint.d/20-envsubst-on-templates.sh.
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
ENV NGINX_LISTEN_ADDRESS=0.0.0.0
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
